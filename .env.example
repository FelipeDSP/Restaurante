# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Apenas servidor/scripts (seed, testes). Nunca expor no browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Supabase CLI: ref do projeto (usado em db:types e supabase link)
SUPABASE_PROJECT_REF=SEU-PROJETO

# Origem pública do site (links do e-mail de confirmação do cadastro). Opcional em dev.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Conta do cliente (entrar com o celular + código). Opcional: sem isso o site esconde o "Entrar".
# Segredo do gancho "Send SMS" do Supabase (o mesmo cadastrado no painel do Supabase / supabase/.env).
# SEND_SMS_HOOK_SECRET=v1,whsec_...
# Quem entrega o código (src/lib/mensagens.ts). "console" só escreve no log (padrão em desenvolvimento).
# MENSAGENS_PROVEDOR=console
